# ============================================================
# CONFIG - Chỉnh sửa phần này trước khi chạy scripts
# ============================================================

# IPs của các node (interface chính - management network)
MASTER_IP="192.168.110.101"
WORKER1_IP="192.168.110.102"
WORKER2_IP="192.168.110.103"

# Hostname (phải khớp với hostnamectl trên từng node)
MASTER_HOSTNAME="k8s-master"
WORKER1_HOSTNAME="k8s-worker-01"
WORKER2_HOSTNAME="k8s-worker-02"

# Kubernetes
K8S_VERSION="1.36"               # major.minor, không cần patch
POD_CIDR="10.244.0.0/16"         # Pod network (Cilium)
SERVICE_CIDR="10.96.0.0/12"      # Service network

# Cilium
CILIUM_CLI_VERSION="v0.19.2"
CILIUM_VERSION="1.19.4"

# MetalLB
METALLB_VERSION="v0.15.3"
METALLB_IP_RANGE="192.168.110.200-192.168.110.220"

# File lưu join command (master tạo, worker đọc)
JOIN_CMD_FILE="/tmp/k8s-join.sh"
